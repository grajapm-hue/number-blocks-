* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
  touch-action: none;
}

body, html {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: #2b2d42;
  color: #fff;
}

#app-container {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  height: -webkit-fill-available;
  position: relative;
  align-items: center;
  justify-content: space-between;
  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
}

.game-header {
  text-align: center;
  padding: 10px;
}

.game-header h1 {
  font-size: 1.6rem;
  color: #f4a261;
}

.game-header .subtitle {
  font-size: 0.9rem;
  opacity: 0.8;
}

.game-area {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.canvas-wrapper {
  width: 100%;
  height: 100%;
  max-width: 600px;
  max-height: 600px;
  display: flex;
  align-items: center;
  justify-content: center;
}

canvas {
  background: transparent;
  border-radius: 50%;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
}

.game-footer {
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 12px;
  background: rgba(0, 0, 0, 0.2);
}

.score-board {
  font-size: 1.1rem;
  font-weight: bold;
}

#reset-btn {
  background: #e76f51;
  color: white;
  border: none;
  padding: 8px 16px;
  font-size: 1rem;
  border-radius: 20px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 4px 6px rgba(0,0,0,0.2);
}

#reset-btn:active {
  transform: scale(0.95);
}

/* Fallback Orientation Overlay */
#orientation-warning {
  display: none;
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(43, 45, 66, 0.95);
  z-index: 999;
  justify-content: center;
  align-items: center;
}

.warning-card {
  text-align: center;
  padding: 20px;
  background: #3d405b;
  border-radius: 16px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.5);
}

.rotate-icon {
  font-size: 3rem;
  margin-bottom: 10px;
  animation: spin 2s infinite linear;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  50% { transform: rotate(180deg); }
  100% { transform: rotate(360deg); }
}

@media screen and (max-aspect-ratio: 1/1) and (max-height: 400px) {
  #orientation-warning {
    display: flex;
  }
}
